<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd sozlamasi: Mac yonganda bot avtomatik ishga tushadi va
  yiqilsa qayta ko'tariladi.

  O'rnatish:
    cp deploy/com.povtor.bot.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.povtor.bot.plist

  To'xtatish:
    launchctl unload ~/Library/LaunchAgents/com.povtor.bot.plist

  Log:
    tail -f var/bot.log

  DIQQAT: WorkingDirectory va Program yo'llari shu mashinaga xos.
  Boshqa joyga ko'chirilsa ular ham o'zgartirilishi kerak.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.povtor.bot</string>

    <key>WorkingDirectory</key>
    <string>/Users/oybek/me/Work/Projects/Telegram bot/POVTOR-ZAKAZ-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/oybek/me/Work/Projects/Telegram bot/POVTOR-ZAKAZ-bot/.venv/bin/python</string>
        <string>-m</string>
        <string>povtor_bot.main</string>
    </array>

    <!-- Yiqilsa qayta ishga tushadi -->
    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <!-- Tez-tez qayta urinishning oldini oladi -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/oybek/me/Work/Projects/Telegram bot/POVTOR-ZAKAZ-bot/var/bot.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/oybek/me/Work/Projects/Telegram bot/POVTOR-ZAKAZ-bot/var/bot.log</string>
</dict>
</plist>
