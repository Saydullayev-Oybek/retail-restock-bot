# ─────────── Telegram ───────────
BOT_TOKEN=123456:AA...
# Botdan foydalanishi mumkin bo'lgan menejerlar (vergul bilan)
ALLOWED_USER_IDS=111111111,222222222
# "Yangi tovar e'loni" yuboriladigan umumiy guruh (manfiy raqam)
ANNOUNCE_CHAT_ID=-1001234567890

# ─────────── Billz ───────────
BILLZ_SECRET_TOKEN=your_secret_key_from_billz_ui
BILLZ_BASE_URL=https://api-admin.billz.ai
# /v2/auth/refresh uchun majburiy header — hujjatdagi statik qiymat
BILLZ_PLATFORM_ID=7d4a4c38-dd84-4902-b744-0488b80a4c01
# Billz sekundiga 2 so'rovga ruxsat beradi; 1.5 xavfsiz zaxira qoldiradi
BILLZ_RATE_LIMIT_RPS=1.5

# Billz `main_image_url` da faqat FAYL NOMINI qaytaradi ("<uuid>.jpg"),
# to'liq manzil emas. Rasm chiqishi uchun CDN bazasi kerak.
# Bo'sh qoldirilsa — kartalar matn ko'rinishida chiqadi (qolgan hammasi ishlaydi).
BILLZ_IMAGE_BASE_URL=

# SKLAD — Billz'da alohida do'kon sifatida turadi.
# ID'ni `python scripts/billz_probe.py --only shops` bilan bilib oling.
# Diqqat: bir nechta "СКЛАД" bo'lishi mumkin — filiallarga tovar YUBORADIGANINI
# tanlang (transfer hisobotidagi from_shop bo'yicha tekshiriladi).
WAREHOUSE_SHOP_ID=
# Kuzatiladigan filiallar (bo'sh qoldirilsa — SKLAD'dan boshqa HAMMA do'kon,
# shu jumladan parfyumeriya/women bo'limlari ham). Aniq ro'yxat berish tavsiya etiladi.
FILIAL_SHOP_IDS=
# Artikul katalogdan necha kunda bir qayta o'qilsin.
# Katalog 70 000+ tovardan iborat bo'lishi mumkin, shuning uchun har artikul
# bir marta o'qilib keshlanadi.
SKU_SYNC_DAYS=7

# ─────────── Nomzod aniqlash qoidasi ───────────
# Kelganidan keyin necha kun ichida kuzatiladi
WINDOW_DAYS=5
# Nomzod bo'lish uchun kerakli sotuv foizi
PERCENT_THRESHOLD=50
# Eng kam partiya hajmi. Skladdan 1-2 dona "to'ldirish" transferlari ko'p keladi,
# ular "tez sotilyapti" degan xulosaga asos bo'lmaydi (kichik partiyada
# tasodif ulushi katta). Namuna POVTOR faylida Asos hech qachon 5 dan kichik emas.
MIN_BASE_QTY=5
# "ishonchli" daraja:  sotilgan >= CONFIDENT_MIN_SOLD
#                  VA  (foiz >= HIGH_PERCENT  YOKI  50%ga yetgan kun <= CONFIDENT_MAX_DAYS)
CONFIDENT_MAX_DAYS=3
CONFIDENT_MIN_SOLD=4
# true => yuqori foiz CONFIDENT_MIN_SOLD ostonasini chetlab o'tadi
# (masalan 2 donadan 2 tasi sotilgani ham "ishonchli" bo'ladi). Default: false.
HIGH_PERCENT_OVERRIDES_MIN_SOLD=false
# Daraja bo'yicha tavsiya etiladigan miqdor
QTY_CONFIDENT=10
QTY_NORMAL=5
# Izohda "N% sotildi" deb yozish chegarasi
HIGH_PERCENT=80

# Faqat shu kategoriya guruhlari hisoblanadi (Billz level_1 nomlari, vergul bilan).
# DIQQAT: nomlar Billz'dagidek AYNAN yozilishi kerak — ular kirill alifbosida.
# Mavjud nomlarni `python scripts/billz_probe.py --only categories` bilan ko'ring.
# Bo'sh qoldirilsa — barcha kategoriyalar.
ALLOWED_CATEGORY_GROUPS=Поясные одежды,Плечевые одежды,Верхняя одежда,Обувь

# ─────────── Boshqa ───────────
DB_PATH=var/povtor.db
TZ=Asia/Tashkent
# Kunlik avtomatik tekshiruv vaqti (HH:MM)
SCHEDULE_TIME=09:00
# "Yangi tovar e'loni" necha kunlik kelgan tovarni qamrasin
ANNOUNCE_LOOKBACK_DAYS=2
# Xom API javoblarini necha kun saqlash (debug uchun)
RAW_RETENTION_DAYS=7
LOG_LEVEL=INFO
